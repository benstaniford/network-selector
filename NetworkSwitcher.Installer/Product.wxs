<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define ProductVersion="1.0.0.0" ?>
  <?define ProductName="Network Switcher" ?>
  <?define Manufacturer="Network Switcher" ?>
  <?define UpgradeCode="F1E2D3C4-B5A6-4978-8A6B-5C4D3E2F1A0B" ?>
  <?define TaskName="NetworkSwitcher" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="$(var.ProductName) Installer"
             Comments="Monitors WiFi and keeps you connected to your target network" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Installation directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="NetworkSwitcher">
          <Directory Id="IconsFolder" Name="icons" />
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Network Switcher"/>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Components -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="NetworkSwitcherExe" Guid="{DA1B2C3D-4E5F-6A7B-8C9D-0E1F2A3B4C5D}">
        <File Id="NetworkSwitcherEXE"
              Source="$(var.NetworkSwitcher.TargetDir)NetworkSwitcher.exe"
              KeyPath="yes"
              Checksum="yes" />
        <File Id="NetworkSwitcherDLL"
              Source="$(var.NetworkSwitcher.TargetDir)NetworkSwitcher.dll" />
        <File Id="NetworkSwitcherRuntimeConfigJson"
              Source="$(var.NetworkSwitcher.TargetDir)NetworkSwitcher.runtimeconfig.json" />
        <File Id="NetworkSwitcherDepsJsonFile"
              Source="$(var.NetworkSwitcher.TargetDir)NetworkSwitcher.deps.json" />
      </Component>

      <!-- NuGet Dependencies - H.NotifyIcon -->
      <Component Id="HNotifyIcon" Guid="{EB2C3D4E-5F6A-7B8C-9D0E-1F2A3B4C5D6E}">
        <File Id="HNotifyIconWpfDll"
              Source="$(var.NetworkSwitcher.TargetDir)H.NotifyIcon.Wpf.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="HNotifyIconCore" Guid="{FC3D4E5F-6A7B-8C9D-0E1F-2A3B4C5D6E7F}">
        <File Id="HNotifyIconDll"
              Source="$(var.NetworkSwitcher.TargetDir)H.NotifyIcon.dll"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Icons folder component -->
    <DirectoryRef Id="IconsFolder">
      <Component Id="IconsComponent" Guid="{AD0E1F2A-3B4C-5D6E-7F8A-9B0C1D2E3F4A}">
        <File Id="AppIco"
              Source="$(var.NetworkSwitcher.TargetDir)icons\app.ico"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu Shortcut: launches the scheduled task so the app starts elevated without UAC -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{BE1F2A3B-4C5D-6E7F-8A9B-0C1D2E3F4A5B}">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Network Switcher"
                  Description="Monitors WiFi and keeps you connected to your target network"
                  Target="[SystemFolder]schtasks.exe"
                  Arguments='/Run /TN "$(var.TaskName)"'
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="app.ico"
                  IconIndex="0"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\NetworkSwitcher"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Desktop Shortcut: same scheduled-task launch path -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{CF2A3B4C-5D6E-7F8A-9B0C-1D2E3F4A5B6C}">
        <Shortcut Id="DesktopShortcut"
                  Name="Network Switcher"
                  Description="Monitors WiFi and keeps you connected to your target network"
                  Target="[SystemFolder]schtasks.exe"
                  Arguments='/Run /TN "$(var.TaskName)"'
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="app.ico"
                  IconIndex="0"/>
        <RemoveFolder Id="CleanUpDesktopShortcut" Directory="DesktopFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\NetworkSwitcher"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="Network Switcher" Level="1">
      <ComponentRef Id="NetworkSwitcherExe" />
      <ComponentRef Id="IconsComponent" />
      <ComponentRef Id="HNotifyIcon" />
      <ComponentRef Id="HNotifyIconCore" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Scheduled Task: created on install, deleted on uninstall.
         /SC ONLOGON triggers at user logon; /RL HIGHEST runs elevated without UAC for admin users.
         Manual launches via shortcuts go through `schtasks /Run` which also bypasses UAC. -->
    <CustomAction Id="SetCreateTaskCmd"
                  Property="CreateTask"
                  Value='"[SystemFolder]schtasks.exe" /Create /TN "$(var.TaskName)" /TR "\"[#NetworkSwitcherEXE]\"" /SC ONLOGON /RL HIGHEST /F' />
    <CustomAction Id="CreateTask"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="SetDeleteTaskCmd"
                  Property="DeleteTask"
                  Value='"[SystemFolder]schtasks.exe" /Delete /TN "$(var.TaskName)" /F' />
    <CustomAction Id="DeleteTask"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Post-install launch: route through schtasks so the .exe is started elevated without UAC -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Network Switcher" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction Id="SetLaunchTaskCmd"
                  Property="LaunchTask"
                  Value='"[SystemFolder]schtasks.exe" /Run /TN "$(var.TaskName)"' />
    <CustomAction Id="LaunchTask"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetCreateTaskCmd" Before="CreateTask">NOT REMOVE</Custom>
      <Custom Action="CreateTask" After="InstallFiles">NOT REMOVE</Custom>

      <Custom Action="SetDeleteTaskCmd" Before="DeleteTask">REMOVE="ALL"</Custom>
      <Custom Action="DeleteTask" Before="RemoveFiles">REMOVE="ALL"</Custom>

      <Custom Action="SetLaunchTaskCmd" After="CreateTask">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Custom>
      <Custom Action="LaunchTask" After="InstallFinalize">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Custom>
    </InstallExecuteSequence>

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Icons -->
    <Icon Id="app.ico" SourceFile="$(var.NetworkSwitcher.TargetDir)icons\app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
  </Product>
</Wix>
